module Openlayer
  module Resources
    class Governance
      class RuleResults
        def retrieve: (
          String rule_result_id,
          ?request_options: Openlayer::request_opts
        ) -> Openlayer::Models::Governance::RuleResultRetrieveResponse

        def update: (
          String rule_result_id,
          ?assignee_id: String?,
          ?blocked_by: ::Array[Openlayer::Governance::RuleResultUpdateParams::BlockedBy],
          ?blocking: ::Array[Openlayer::Governance::RuleResultUpdateParams::Blocking],
          ?deactivated: bool,
          ?deactivated_reason: String?,
          ?request_options: Openlayer::request_opts
        ) -> Openlayer::Models::Governance::RuleResultUpdateResponse

        def list: (
          String workspace_id,
          ?enabled_framework_only: bool,
          ?framework_id: String,
          ?include_unframed: bool,
          ?page: Integer,
          ?per_page: Integer,
          ?project_id: String,
          ?rule_id: String,
          ?scope: Openlayer::Models::Governance::RuleResultListParams::scope,
          ?search_query: String,
          ?status: Openlayer::Models::Governance::RuleResultListParams::status,
          ?type: Openlayer::Models::Governance::RuleResultListParams::type_,
          ?request_options: Openlayer::request_opts
        ) -> Openlayer::Models::Governance::RuleResultListResponse

        def create_evidence: (
          String rule_result_id,
          ?description: String?,
          ?name: String?,
          ?storage_uri: String?,
          ?text: String?,
          ?url: String?,
          ?request_options: Openlayer::request_opts
        ) -> Openlayer::Models::Governance::RuleResultCreateEvidenceResponse

        def list_evidence: (
          String rule_result_id,
          ?page: Integer,
          ?per_page: Integer,
          ?request_options: Openlayer::request_opts
        ) -> Openlayer::Models::Governance::RuleResultListEvidenceResponse

        def initialize: (client: Openlayer::Client) -> void
      end
    end
  end
end
