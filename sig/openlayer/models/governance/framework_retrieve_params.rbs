module Openlayer
  module Models
    module Governance
      type framework_retrieve_params =
        { framework_id: String } & Openlayer::Internal::Type::request_parameters

      class FrameworkRetrieveParams < Openlayer::Internal::Type::BaseModel
        extend Openlayer::Internal::Type::RequestParameters::Converter
        include Openlayer::Internal::Type::RequestParameters

        attr_accessor framework_id: String

        def initialize: (
          framework_id: String,
          ?request_options: Openlayer::request_opts
        ) -> void

        def to_hash: -> {
          framework_id: String,
          request_options: Openlayer::RequestOptions
        }
      end
    end
  end
end
